{
  "schemaVersion": 2,
  "project": { "name": "multi-provider-example" },
  "defaults": {
    "planner": {
      "provider": "codex",
      "role": "planner",
      "modelSelector": "frontier",
      "reasoningEffort": "low",
      "executionClass": "decision"
    },
    "reviewer": {
      "provider": "codex",
      "role": "reviewer",
      "modelSelector": "efficient",
      "reasoningEffort": "xhigh",
      "executionClass": "review"
    }
  },
  "strategy": {
    "profile": "balanced",
    "defaultRisk": "R1",
    "frontierReviewAt": "R3",
    "sleepingOrchestrator": true,
    "escalation": [
      { "modelSelector": "efficient", "reasoningEffort": "xhigh" },
      { "modelSelector": "balanced", "reasoningEffort": "medium" },
      { "modelSelector": "frontier", "reasoningEffort": "low" },
      { "modelSelector": "frontier", "reasoningEffort": "medium" }
    ]
  },
  "policy": {
    "maxParallelWorkers": 2,
    "maxSelectedWorkers": 2,
    "resultMaxChars": 2000,
    "allowThreadCreation": false
  },
  "workers": [
    {
      "name": "claude-implementation",
      "role": "implementation",
      "provider": "claude",
      "threadTitle": "Worker: Claude implementation",
      "purpose": "Make bounded code changes from a frozen implementation contract.",
      "modelSelector": "sonnet",
      "reasoningEffort": "high",
      "executionClass": "workhorse",
      "maxFollowups": 1,
      "parallel": false
    },
    {
      "name": "grok-research",
      "role": "research-docs",
      "provider": "grok",
      "threadTitle": "Worker: Grok research",
      "purpose": "Collect repository facts and update bounded documentation.",
      "modelSelector": "default",
      "reasoningEffort": "medium",
      "executionClass": "workhorse",
      "maxFollowups": 1,
      "parallel": true
    },
    {
      "name": "cursor-review",
      "role": "security-review",
      "provider": "cursor",
      "threadTitle": "Worker: Cursor review",
      "purpose": "Perform independent security and privacy review for bounded diffs.",
      "modelSelector": "default",
      "reasoningEffort": "medium",
      "executionClass": "specialist",
      "maxFollowups": 1,
      "parallel": true
    },
    {
      "name": "codex-integration",
      "role": "integration",
      "provider": "codex",
      "threadTitle": "Worker: Codex integration",
      "purpose": "Review evidence and integrate bounded worker results.",
      "modelSelector": "frontier",
      "reasoningEffort": "low",
      "executionClass": "review",
      "maxFollowups": 1,
      "parallel": false
    }
  ]
}
