{
  "schemaVersion": 2,
  "project": { "name": "example-project" },
  "defaults": {
    "planner": {
      "role": "planner",
      "modelSelector": "frontier",
      "reasoningEffort": "low",
      "executionClass": "decision"
    },
    "reviewer": {
      "role": "reviewer",
      "modelSelector": "efficient",
      "reasoningEffort": "xhigh",
      "executionClass": "review"
    }
  },
  "strategy": {
    "profile": "economy",
    "defaultRisk": "R1",
    "frontierReviewAt": "R3",
    "sleepingOrchestrator": true,
    "escalation": [
      { "modelSelector": "efficient", "reasoningEffort": "xhigh" },
      { "modelSelector": "balanced", "reasoningEffort": "medium" },
      { "modelSelector": "frontier", "reasoningEffort": "low" },
      { "modelSelector": "frontier", "reasoningEffort": "medium" }
    ]
  },
  "policy": {
    "maxParallelWorkers": 2,
    "maxSelectedWorkers": 2,
    "resultMaxChars": 2000,
    "allowThreadCreation": false
  },
  "workers": [
    {
      "name": "implementation",
      "role": "implementation",
      "threadTitle": "Worker: implementation",
      "purpose": "Make bounded code changes from a frozen implementation contract.",
      "modelSelector": "efficient",
      "reasoningEffort": "xhigh",
      "executionClass": "workhorse",
      "maxFollowups": 1,
      "parallel": false
    },
    {
      "name": "test-debug",
      "role": "test-debug",
      "threadTitle": "Worker: test and debug",
      "purpose": "Add regression tests and diagnose focused failures.",
      "modelSelector": "efficient",
      "reasoningEffort": "xhigh",
      "executionClass": "workhorse",
      "maxFollowups": 1,
      "parallel": true
    },
    {
      "name": "research-docs",
      "role": "research-docs",
      "threadTitle": "Worker: research and docs",
      "purpose": "Collect repository facts and update bounded documentation.",
      "modelSelector": "efficient",
      "reasoningEffort": "high",
      "executionClass": "workhorse",
      "maxFollowups": 1,
      "parallel": true
    },
    {
      "name": "security-review",
      "role": "security-review",
      "threadTitle": "Worker: security review",
      "purpose": "Review high-risk diffs for security, privacy, and destructive regressions.",
      "modelSelector": "frontier",
      "reasoningEffort": "medium",
      "executionClass": "specialist",
      "maxFollowups": 1,
      "parallel": true
    }
  ]
}
