{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "provider", "changedPaths", "checks", "remainingConcerns"],
  "properties": {
    "status": {"type": "string", "enum": ["complete", "blocked", "failed"]},
    "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "changedPaths": {"type": "array", "items": {"type": "string"}},
    "checks": {"type": "array", "items": {"type": "string"}},
    "remainingConcerns": {"type": "array", "items": {"type": "string"}}
  }
}
