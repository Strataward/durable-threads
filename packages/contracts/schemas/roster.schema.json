{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Strataward/durable-threads/schemas/roster.schema.json",
  "type": "object",
  "required": ["schemaVersion", "project", "defaults", "workers"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "required": ["planner", "reviewer"],
      "properties": {
        "planner": { "$ref": "#/$defs/role" },
        "reviewer": { "$ref": "#/$defs/role" }
      },
      "additionalProperties": false
    },
    "strategy": {
      "type": "object",
      "properties": {
        "profile": { "enum": ["economy", "balanced", "frontier"] },
        "defaultRisk": { "$ref": "#/$defs/risk" },
        "frontierReviewAt": { "$ref": "#/$defs/risk" },
        "sleepingOrchestrator": { "type": "boolean" },
        "escalation": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/escalationStep" }
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "maxParallelWorkers": { "type": "integer", "minimum": 1 },
        "maxSelectedWorkers": { "type": "integer", "minimum": 1 },
        "resultMaxChars": { "type": "integer", "minimum": 200 },
        "allowThreadCreation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/worker" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "risk": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "executionClass": { "enum": ["decision", "workhorse", "review", "specialist"] },
    "effort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"] },
    "role": {
      "type": "object",
      "required": ["role", "modelSelector", "reasoningEffort"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "modelSelector": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "$ref": "#/$defs/effort" },
        "executionClass": { "$ref": "#/$defs/executionClass" }
      },
      "additionalProperties": false
    },
    "worker": {
      "type": "object",
      "required": ["name", "role", "threadTitle", "purpose", "modelSelector"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "threadTitle": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "threadId": { "type": ["string", "null"] },
        "modelSelector": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "$ref": "#/$defs/effort" },
        "executionClass": { "$ref": "#/$defs/executionClass" },
        "maxFollowups": { "type": "integer", "minimum": 0, "maximum": 3 },
        "parallel": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "escalationStep": {
      "type": "object",
      "required": ["modelSelector", "reasoningEffort"],
      "properties": {
        "modelSelector": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "$ref": "#/$defs/effort" }
      },
      "additionalProperties": false
    }
  }
}
